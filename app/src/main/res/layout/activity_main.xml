<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    tools:context=".MainActivity">

    <!-- ========================================================= -->
    <!-- TOP TABS                                                   -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:elevation="4dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/authenticationTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Authentication"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="#2451A6"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/settingsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Settings"
            android:textColor="#222222"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT                                               -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/authScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/authPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- AUTHENTICATION TITLE                               -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Authentication"
                android:textColor="#222222"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Select authentication methods"
                android:textColor="#666666"
                android:textSize="16sp" />


            <!-- ================================================= -->
            <!-- AUTHENTICATION METHODS CARD                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/authMethodsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Authentication Methods"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- Finger -->

                <CheckBox
                    android:id="@+id/fingerCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Finger"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:padding="4dp" />


                <LinearLayout
                    android:id="@+id/fingerOptionsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="Finger Count"
                        android:textColor="#555555"
                        android:textSize="15sp" />

                    <Spinner
                        android:id="@+id/fingerCountSpinner"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />

                </LinearLayout>


                <!-- Face -->

                <CheckBox
                    android:id="@+id/faceCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Face"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/faceCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="Count: 1" />


                <!-- Iris -->

                <CheckBox
                    android:id="@+id/irisCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Iris"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:padding="4dp" />


                <LinearLayout
                    android:id="@+id/irisOptionsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="Iris Type"
                        android:textColor="#555555"
                        android:textSize="15sp" />

                    <Spinner
                        android:id="@+id/irisTypeSpinner"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />

                </LinearLayout>


                <!-- OTP -->

                <CheckBox
                    android:id="@+id/otpCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="OTP"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- IDENTITY INFORMATION                              -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/identityAuthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identity"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/individualIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="UIN"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/individualIdTypeEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="UIN Type"
                    android:text="UIN" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- OTP SECTION                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/otpSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/otpAuthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OTP Authentication"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="OTP will be sent to the registered email"
                    android:textColor="#666666"
                    android:textSize="14sp" />


                <Button
                    android:id="@+id/requestOtpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Request OTP"
                    android:textAllCaps="false" />


                <EditText
                    android:id="@+id/otpEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Enter OTP"
                    android:inputType="number"
                    android:maxLength="10"
                    android:enabled="false"
                    android:padding="12dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BIOMETRIC ACTIONS                                  -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/actionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <Button
                    android:id="@+id/captureButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Capture"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/authButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Authenticate"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Reset"
                    android:textAllCaps="false" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- OLD SBI BUTTONS                                   -->
            <!-- ================================================= -->
            <!--
                 Discovery and Device Info are automatic now.
                 IDs are retained temporarily because current
                 MainActivity still references them.
                 They will be removed from Java in the next step.
            -->

            <Button
                android:id="@+id/discoverButton"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/infoButton"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- SETTINGS PAGE                                              -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:visibility="gone"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- SETTINGS TITLE                                     -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Settings"
                android:textColor="#222222"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Configure MOSIP and partner settings"
                android:textColor="#666666"
                android:textSize="16sp" />


            <!-- ================================================= -->
            <!-- MOSIP CONFIGURATION                                -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/mosipSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOSIP Configuration"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/baseUrlEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Base URL / DNS"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/domainUriEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Domain URI"
                    android:inputType="textUri" />

                <Spinner
                    android:id="@+id/environmentSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- AUTH MANAGER                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/authManagerSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Authentication Configuration"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/authManagerUrlEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Auth Manager URL"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/authManagerClientIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Auth Manager Client ID" />

                <EditText
                    android:id="@+id/authManagerSecretEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Auth Manager Secret"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/authManagerAppIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Auth Manager App ID" />

                <EditText
                    android:id="@+id/certificateUrlEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Certificate URL"
                    android:inputType="textUri" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PARTNER CONFIGURATION                              -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/partnerSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partner Configuration"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/mispLicenseKeyEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="MISP License Key"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/partnerIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Partner ID" />

                <EditText
                    android:id="@+id/partnerApiKeyEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Partner API Key"
                    android:inputType="textPassword" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PARTNER SIGNING CERTIFICATE                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/certificateSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partner Signing Certificate"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/p12FileEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="P12 file"
                        android:focusable="false"
                        android:clickable="false" />

                    <Button
                        android:id="@+id/browseP12Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Browse"
                        android:textAllCaps="false" />

                </LinearLayout>

                <EditText
                    android:id="@+id/p12PasswordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="P12 Password"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/p12AliasEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="P12 Alias" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SETTINGS ACTIONS                                   -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/settingsActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsCancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/settingsSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Save"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>